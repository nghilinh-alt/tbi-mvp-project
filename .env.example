/**
 * TBI-MVP Project - Environment Configuration Template
 * Copy this file to .env and fill in your actual credentials
 */

# ============================================
# Frontend (Vite React App)
# ============================================

# API Backend URL for frontend
API_BASE_URL=http://localhost:8000/api/v1

# Frontend development/port settings
VITE_PORT=5173
VITE_HOST=localhost

# ============================================
# Backend (FastAPI Server)
# ============================================

# Backend server settings
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Database configuration (SQLite for local, PostgreSQL for production)
DATABASE_URL="sqlite:///./app.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/tbi_mvp"

# JWT Secret Key (change in production!)
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# ============================================
# CORS Configuration
# ============================================

# Allow frontend origin (update for production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================
# Logging
# ============================================

LOG_LEVEL=DEBUG  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json   # json or text

# ============================================
# Application Settings
# ============================================

APP_NAME=TBI Employment Pathways MVP
APP_ENV=development  # development, staging, production
DEBUG=true          # true for local development, false for production
